# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=replace-with-a-long-random-secret
# Generate with: python3 -c "from werkzeug.security import generate_password_hash as h; print(h('your-password'))"
DASHBOARD_PASSWORD_HASH=replace-with-a-werkzeug-password-hash
# Keep true once HTTPS is enabled via Nginx/Cloudflare.
COOKIE_SECURE=true
# Name of the existing systemd service running bot.py.
BOT_SERVICE=shardnote-bot.service

